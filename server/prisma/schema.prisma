generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  CUSTOMER
}

enum OrganizationRole {
  OWNER
  MANAGER
  CONTRIBUTOR
  VIEWER
  WEBINK_SPECIALIST
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Locale {
  EN
  FR
}

enum ClientStatus {
  LEAD
  PROPOSAL
  APPROVED
  ACTIVE
  INACTIVE
}

enum BriefStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  IN_PROGRESS
  COMPLETE
  ARCHIVED
}

enum RequirementCategory {
  PAGE
  FEATURE
  CONTENT
  SEO
  DESIGN
  TECHNICAL
}

enum RequirementPriority {
  MUST
  SHOULD
  FUTURE
}

enum RequirementStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  REJECTED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  FOLLOW_UP
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AttachmentCategory {
  BRAND
  CONTENT
  REFERENCE
  CONTRACT
  SCREENSHOT
  OTHER
}

enum ProjectWorkflowStatus {
  DRAFT
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  PRODUCTION
  COMPLETED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum GoalPeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELETED
}

enum ActivityEntityType {
  PROJECT
  MILESTONE
  TASK
  GOAL
  BUDGET
  DESIGN_DOCUMENT
  BRAND_KIT
  PROJECT_ASSET
  CREATIVE_BRIEF
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String
  role                    Role                     @default(CUSTOMER)
  organizationMemberships OrganizationMembership[]
  invitationsSent         OrganizationInvitation[] @relation("InvitationSender")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  taskComments            TaskComment[]
  activityLogEntries      ActivityLogEntry[]
  linkedDesignDocuments   DesignDocument[]
  designReviewsToDo       DesignReview[]           @relation("DesignReviewer")
  designReviewsAssigned   DesignReview[]           @relation("DesignReviewAssigner")
  designComments          DesignComment[]
  createdProjectAssets    ProjectAsset[]
  createdAssetRevisions   AssetRevision[]          @relation("AssetRevisionCreator")
  approvedAssetRevisions  AssetRevision[]          @relation("AssetRevisionApprover")
  requestedAssetExports   AssetExport[]
  createdCreativeBriefs   CreativeBrief[]          @relation("CreativeBriefCreator")
  approvedCreativeBriefs  CreativeBrief[]          @relation("CreativeBriefApprover")
  aiUsageRequests         AiUsageRecord[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Organization {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  memberships    OrganizationMembership[]
  invitations    OrganizationInvitation[]
  clients        Client[]
  projects       Project[]
  goals          Goal[]
  activityLog    ActivityLogEntry[]
  brandKit       BrandKit?
  aiUsageRecords AiUsageRecord[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([name])
}

model ActivityLogEntry {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     ActivityEntityType
  entityId       String
  action         ActivityAction
  summary        String
  actorId        String?
  actor          User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@index([organizationId, email, acceptedAt, revokedAt])
  @@index([expiresAt])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  role           OrganizationRole @default(VIEWER)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Client {
  id              String           @id @default(cuid())
  companyName     String
  industry        String?
  website         String?
  serviceArea     String?
  status          ClientStatus     @default(LEAD)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  generalNotes    String?
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  discoveryBriefs DiscoveryBrief[]

  @@index([status, companyName])
  @@index([organizationId, status])
}

model DiscoveryBrief {
  id                 String             @id @default(cuid())
  title              String
  status             BriefStatus        @default(DRAFT)
  meetingAt          DateTime?
  projectType        String
  projectSummary     String?
  motivation         String?
  currentProblems    String?
  successDefinition  String?
  targetLaunch       String?
  budget             String?
  decisionMakers     String?
  primaryAudience    String?
  secondaryAudiences String?
  audienceProblems   String?
  commonObjections   String?
  desiredAction      String?
  designDirection    String?
  likedSites         String?
  dislikedSites      String?
  brandAssets        String?
  seoTargets         String?
  targetLocations    String?
  currentPlatform    String?
  integrations       String?
  hostingProvider    String?
  domainRegistrar    String?
  compliance         String?
  assumptions        String?
  outOfScope         String?
  rawNotes           String?
  approvedBy         String?
  approvedAt         DateTime?
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirements       BriefRequirement[]
  openQuestions      BriefQuestion[]
  generatedPrompts   GeneratedPrompt[]
  attachments        BriefAttachment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([clientId, status])
  @@index([meetingAt])
}

model BriefAttachment {
  id          String             @id @default(cuid())
  fileName    String
  objectKey   String             @unique
  contentType String
  fileSize    Int
  category    AttachmentCategory @default(OTHER)
  createdAt   DateTime           @default(now())
  briefId     String
  brief       DiscoveryBrief     @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, category, createdAt])
}

model BriefRequirement {
  id                 String              @id @default(cuid())
  referenceCode      String?
  category           RequirementCategory
  priority           RequirementPriority @default(MUST)
  status             RequirementStatus   @default(PLANNED)
  title              String
  details            String?
  rationale          String?
  acceptanceCriteria String?
  briefId            String
  brief              DiscoveryBrief      @relation(fields: [briefId], references: [id], onDelete: Cascade)
  sortOrder          Int                 @default(0)

  @@index([briefId, category, sortOrder])
  @@index([briefId, status])
}

model BriefQuestion {
  id        String           @id @default(cuid())
  question  String
  answer    String?
  status    QuestionStatus   @default(OPEN)
  owner     String?
  dueDate   DateTime?
  priority  FollowUpPriority @default(NORMAL)
  briefId   String
  brief     DiscoveryBrief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  sortOrder Int              @default(0)

  @@index([briefId, status, sortOrder])
  @@index([briefId, dueDate, status])
}

model GeneratedPrompt {
  id        String         @id @default(cuid())
  content   String
  createdAt DateTime       @default(now())
  briefId   String
  brief     DiscoveryBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, createdAt])
}

model PortfolioProject {
  id           String               @id @default(cuid())
  slug         String               @unique
  clientName   String?
  projectUrl   String?
  status       ProjectStatus        @default(DRAFT)
  featured     Boolean              @default(false)
  displayOrder Int                  @default(0)
  completedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]
  images       PortfolioImage[]
  categories   PortfolioCategory[]

  @@index([status, displayOrder])
  @@index([featured, status])
}

model ProjectTranslation {
  id              String           @id @default(cuid())
  locale          Locale
  title           String
  summary         String
  challenge       String?
  solution        String?
  results         String?
  seoTitle        String?
  metaDescription String?
  projectId       String
  project         PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model PortfolioImage {
  id        String           @id @default(cuid())
  url       String
  altTextEn String
  altTextFr String?
  width     Int?
  height    Int?
  sortOrder Int              @default(0)
  isCover   Boolean          @default(false)
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model PortfolioCategory {
  id       String             @id @default(cuid())
  slug     String             @unique
  nameEn   String
  nameFr   String
  projects PortfolioProject[]
}

model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String?
  service     String
  budget      String?
  launchDate  String?
  website     String?
  message     String
  source      String?
  createdAt   DateTime  @default(now())
  contactedAt DateTime?

  @@index([createdAt])
}

model Project {
  id              String                @id @default(cuid())
  name            String
  description     String?
  status          ProjectWorkflowStatus @default(DRAFT)
  startDate       DateTime?
  targetLaunch    DateTime?
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  goalId          String?
  goal            Goal?                 @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestones      Milestone[]
  tasks           Task[]
  budget          Budget?
  designDocuments DesignDocument[]
  assets          ProjectAsset[]
  creativeBriefs  CreativeBrief[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@index([goalId])
}

model Budget {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currency        String   @default("USD")
  plannedAmount   Decimal? @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)
  committedAmount Decimal? @db.Decimal(12, 2)
  actualAmount    Decimal? @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Goal {
  id             String       @id @default(cuid())
  title          String
  description    String?
  period         GoalPeriod
  year           Int
  status         GoalStatus   @default(ON_TRACK)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projects       Project[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, year, period])
}

model Milestone {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      MilestoneStatus @default(PLANNED)
  dueDate     DateTime?
  sortOrder   Int             @default(0)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, sortOrder])
  @@index([projectId, dueDate])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  dueDate     DateTime?
  sortOrder   Int           @default(0)
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, status, sortOrder])
  @@index([projectId, milestoneId])
  @@index([assigneeId, status])
  @@index([projectId, dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

model DesignDocument {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name         String
  figmaFileKey String
  figmaNodeId  String?
  figmaUrl     String
  linkedById   String
  linkedBy     User            @relation(fields: [linkedById], references: [id], onDelete: Restrict)
  unlinkedAt   DateTime?
  versions     DesignVersion[]
  reviews      DesignReview[]
  comments     DesignComment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId, unlinkedAt])
}

model DesignVersion {
  id                String         @id @default(cuid())
  designDocumentId  String
  designDocument    DesignDocument @relation(fields: [designDocumentId], references: [id], onDelete: Cascade)
  thumbnailUrl      String?
  figmaLastModified DateTime?
  syncedAt          DateTime       @default(now())
  decidingReviews   DesignReview[]

  @@index([designDocumentId, syncedAt])
}

enum DesignReviewStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
}

model DesignReview {
  id               String             @id @default(cuid())
  designDocumentId String
  designDocument   DesignDocument     @relation(fields: [designDocumentId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewer         User               @relation("DesignReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedById     String
  assignedBy       User               @relation("DesignReviewAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  dueDate          DateTime?
  status           DesignReviewStatus @default(PENDING)
  decidedVersionId String?
  decidedVersion   DesignVersion?     @relation(fields: [decidedVersionId], references: [id], onDelete: SetNull)
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([designDocumentId, status])
  @@index([reviewerId, status])
}

model DesignComment {
  id               String         @id @default(cuid())
  designDocumentId String
  designDocument   DesignDocument @relation(fields: [designDocumentId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body             String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([designDocumentId, createdAt])
}

model BrandKit {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  fontFamily     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum TemplateCategory {
  FLYER
  SOCIAL_GRAPHIC
  NEWSLETTER
  AD
}

enum TemplateFieldType {
  TEXT
  IMAGE
  COLOR
  CTA_TEXT
  CTA_URL
}

model DesignTemplate {
  id              String           @id @default(cuid())
  name            String
  description     String?
  category        TemplateCategory
  previewImageUrl String?
  isPublished     Boolean          @default(true)
  canvasWidth     Int              @default(1200)
  canvasHeight    Int              @default(1200)
  fields          TemplateField[]
  assets          ProjectAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category, isPublished])
}

model TemplateField {
  id         String            @id @default(cuid())
  templateId String
  template   DesignTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  fieldType  TemplateFieldType
  required   Boolean           @default(false)
  maxLength  Int?
  sortOrder  Int               @default(0)
  x          Int               @default(0)
  y          Int               @default(0)
  width      Int               @default(200)
  height     Int               @default(60)
  fontSize   Int               @default(24)
  color      String?
  values     AssetFieldValue[]

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model ProjectAsset {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  templateId  String
  template    DesignTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name        String
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  revisions   AssetRevision[]
  unlinkedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, unlinkedAt])
}

enum AssetRevisionStatus {
  DRAFT
  APPROVED
}

model AssetRevision {
  id             String              @id @default(cuid())
  projectAssetId String
  projectAsset   ProjectAsset        @relation(fields: [projectAssetId], references: [id], onDelete: Cascade)
  status         AssetRevisionStatus @default(DRAFT)
  values         AssetFieldValue[]
  exports        AssetExport[]
  createdById    String
  createdBy      User                @relation("AssetRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById   String?
  approvedBy     User?               @relation("AssetRevisionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([projectAssetId, createdAt])
}

model AssetFieldValue {
  id              String        @id @default(cuid())
  revisionId      String
  revision        AssetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  templateFieldId String
  templateField   TemplateField @relation(fields: [templateFieldId], references: [id], onDelete: Restrict)
  value           String

  @@unique([revisionId, templateFieldId])
}

enum ExportFormat {
  PNG
  PDF
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

model AssetExport {
  id              String        @id @default(cuid())
  assetRevisionId String
  assetRevision   AssetRevision @relation(fields: [assetRevisionId], references: [id], onDelete: Cascade)
  format          ExportFormat
  status          ExportStatus  @default(PENDING)
  objectKey       String?
  errorMessage    String?
  requestedById   String
  requestedBy     User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  @@index([assetRevisionId, createdAt])
}

enum CreativeBriefStatus {
  DRAFT
  APPROVED
}

model CreativeBrief {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  summary         String
  audienceNotes   String
  copyAngles      String
  layoutDirection String
  readinessScore  Int
  readinessNotes  String
  status          CreativeBriefStatus @default(DRAFT)
  createdById     String
  createdBy       User                @relation("CreativeBriefCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?               @relation("CreativeBriefApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId, createdAt])
}

enum AiUsagePurpose {
  CREATIVE_BRIEF
}

model AiUsageRecord {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById       String
  requestedBy         User           @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  purpose             AiUsagePurpose
  model               String
  promptTokens        Int
  completionTokens    Int
  estimatedCostMicros Int
  createdAt           DateTime       @default(now())

  @@index([organizationId, createdAt])
}

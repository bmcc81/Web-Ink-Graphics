generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Locale {
  EN
  FR
}

enum ClientStatus {
  LEAD
  PROPOSAL
  APPROVED
  ACTIVE
  INACTIVE
}

enum BriefStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  IN_PROGRESS
  COMPLETE
  ARCHIVED
}

enum RequirementCategory {
  PAGE
  FEATURE
  CONTENT
  SEO
  DESIGN
  TECHNICAL
}

enum RequirementPriority {
  MUST
  SHOULD
  FUTURE
}

enum RequirementStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  REJECTED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  FOLLOW_UP
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AttachmentCategory {
  BRAND
  CONTENT
  REFERENCE
  CONTRACT
  SCREENSHOT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id             String           @id @default(cuid())
  companyName    String
  industry       String?
  website        String?
  serviceArea    String?
  status         ClientStatus     @default(LEAD)
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  generalNotes   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  discoveryBriefs DiscoveryBrief[]

  @@index([status, companyName])
}

model DiscoveryBrief {
  id                 String             @id @default(cuid())
  title              String
  status             BriefStatus        @default(DRAFT)
  meetingAt          DateTime?
  projectType        String
  projectSummary     String?
  motivation         String?
  currentProblems    String?
  successDefinition  String?
  targetLaunch       String?
  budget             String?
  decisionMakers     String?
  primaryAudience    String?
  secondaryAudiences String?
  audienceProblems   String?
  commonObjections   String?
  desiredAction      String?
  designDirection    String?
  likedSites         String?
  dislikedSites      String?
  brandAssets        String?
  seoTargets         String?
  targetLocations    String?
  currentPlatform    String?
  integrations       String?
  hostingProvider    String?
  domainRegistrar    String?
  compliance         String?
  assumptions        String?
  outOfScope         String?
  rawNotes           String?
  approvedBy         String?
  approvedAt         DateTime?
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirements       BriefRequirement[]
  openQuestions      BriefQuestion[]
  generatedPrompts   GeneratedPrompt[]
  attachments        BriefAttachment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([clientId, status])
  @@index([meetingAt])
}

model BriefAttachment {
  id          String             @id @default(cuid())
  fileName    String
  objectKey   String             @unique
  contentType String
  fileSize    Int
  category    AttachmentCategory @default(OTHER)
  createdAt   DateTime           @default(now())
  briefId     String
  brief       DiscoveryBrief     @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, category, createdAt])
}

model BriefRequirement {
  id                 String              @id @default(cuid())
  referenceCode      String?
  category           RequirementCategory
  priority           RequirementPriority @default(MUST)
  status             RequirementStatus   @default(PLANNED)
  title              String
  details            String?
  rationale          String?
  acceptanceCriteria String?
  briefId            String
  brief              DiscoveryBrief      @relation(fields: [briefId], references: [id], onDelete: Cascade)
  sortOrder          Int                 @default(0)

  @@index([briefId, category, sortOrder])
  @@index([briefId, status])
}

model BriefQuestion {
  id        String         @id @default(cuid())
  question  String
  answer    String?
  status    QuestionStatus @default(OPEN)
  owner     String?
  dueDate   DateTime?
  priority  FollowUpPriority @default(NORMAL)
  briefId   String
  brief     DiscoveryBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)

  @@index([briefId, status, sortOrder])
  @@index([briefId, dueDate, status])
}

model GeneratedPrompt {
  id        String         @id @default(cuid())
  content   String
  createdAt DateTime       @default(now())
  briefId   String
  brief     DiscoveryBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, createdAt])
}

model PortfolioProject {
  id           String             @id @default(cuid())
  slug         String             @unique
  clientName   String?
  projectUrl   String?
  status       ProjectStatus      @default(DRAFT)
  featured     Boolean            @default(false)
  displayOrder Int                @default(0)
  completedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  translations ProjectTranslation[]
  images       PortfolioImage[]
  categories   PortfolioCategory[]

  @@index([status, displayOrder])
  @@index([featured, status])
}

model ProjectTranslation {
  id              String           @id @default(cuid())
  locale          Locale
  title           String
  summary         String
  challenge       String?
  solution        String?
  results         String?
  seoTitle        String?
  metaDescription String?
  projectId       String
  project         PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model PortfolioImage {
  id        String           @id @default(cuid())
  url       String
  altTextEn String
  altTextFr String?
  width     Int?
  height    Int?
  sortOrder Int              @default(0)
  isCover   Boolean          @default(false)
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model PortfolioCategory {
  id       String             @id @default(cuid())
  slug     String             @unique
  nameEn   String
  nameFr   String
  projects PortfolioProject[]
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String?
  service     String
  budget      String?
  launchDate  String?
  website     String?
  message     String
  source      String?
  createdAt   DateTime @default(now())
  contactedAt DateTime?

  @@index([createdAt])
}
